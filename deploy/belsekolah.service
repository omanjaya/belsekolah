[Unit]
Description=Bel Sekolah otomatis
Documentation=file:///usr/local/share/doc/belsekolah/PANDUAN-INSTAL.md
After=network-online.target sound.target
StartLimitIntervalSec=0
Wants=network-online.target

[Service]
Type=simple
User=belsekolah
Group=belsekolah
SupplementaryGroups=audio
Environment=HOME=/var/lib/belsekolah
Environment=BELSEKOLAH_TZ=Asia/Jakarta
EnvironmentFile=-/etc/default/belsekolah
ExecStart=/usr/local/bin/belsekolah -data /var/lib/belsekolah -addr :80 -tz ${BELSEKOLAH_TZ}
Restart=always
RestartSec=2

# Port 80 tanpa root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Pengerasan: hanya folder data yang boleh ditulis.
ProtectSystem=strict
ReadWritePaths=/var/lib/belsekolah
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
